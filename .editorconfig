root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
tab_width = 4

# Tabs are invalid in YAML.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Spaces keep nested lists reliable; trailing double spaces are line breaks.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Generated by npm.
[package-lock.json]
indent_style = space
indent_size = 2
