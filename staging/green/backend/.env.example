
# Django Green - ambiente privado de staging
SECRET_KEY=<GENERATE_UNIQUE_GREEN_SECRET>
DEBUG=False

# Acesso local através de SSH port forwarding
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
CSRF_TRUSTED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
FRONTEND_URL=http://localhost:8081

# HTTP permitido apenas nos testes privados Green
COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# PostgreSQL Green
DB_NAME=financeapp_green
DB_USER=financeapp_green
DB_PASSWORD=<SAME_PASSWORD_AS_GREEN_POSTGRES>
DB_HOST=db
DB_PORT=5432

# Emails de teste: não utilizar credenciais Resend de produção
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
